# ==================== 连接模式 ====================
# false: 通过 Nginx 代理访问（默认）- 使用域名
# true: 直连各服务 IP:端口
VITE_USE_DIRECT_CONNECTION=false

# 直连模式下指定服务 host（仅 VITE_USE_DIRECT_CONNECTION=true 时生效）
VITE_SERVICE_HOST=127.0.0.1

# ==================== 域名模式配置（VITE_USE_DIRECT_CONNECTION=false 时使用）====================
VITE_API_BASE_URL=http://43.143.124.220
VITE_WS_BASE_URL=ws://43.143.124.220
