std::shared_ptr<game_base::PlayerSessionBase> GomokuWebSocketHandler::createPlayerSession(
    const std::string& player_id, int client_fd, const std::string& client_ip) {
    
    LOG_INFO("创建五子棋玩家会话: " + player_id);
    
    try {
        // 创建具体的五子棋玩家会话实例
        auto session = std::make_shared<GomokuPlayerSession>(player_id, client_fd, client_ip);
        
        // 初始化会话
        if (!session->initialize()) {
            LOG_ERROR("玩家会话初始化失败: " + player_id);
            return nullptr;
        }
        
        // 设置消息处理回调
        session->setMessageHandler([this](const std::string& pid, const nlohmann::json& msg) {
            handleGomokuGameMessage(pid, msg);
        });
        
        LOG_INFO("五子棋玩家会话创建成功: " + player_id);
        return session;
        
    } catch (const std::exception& e) {
        LOG_ERROR("创建玩家会话异常: " + std::string(e.what()));
        return nullptr;
    }
}
