    Task3 --> RegisterGateway
    Task4 --> RegisterGateway
    Task5 --> RegisterGateway
    Task6 --> RegisterGateway
    Task7 --> RegisterGateway
    Task8 --> RegisterGateway
    
    RegisterGateway --> GatewayReg{网关注册}
