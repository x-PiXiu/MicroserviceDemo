# =============================================================================
# 游戏微服务环境变量配置
# 复制此文件为 .env 并根据实际环境修改
# =============================================================================

# -----------------------------------------------------------------------------
# 全局配置
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=game-microservices
VERSION=latest
TZ=Asia/Shanghai

# -----------------------------------------------------------------------------
# 部署模式配置
# -----------------------------------------------------------------------------
# USE_EXTERNAL_DB: 是否使用外部数据库（非 Docker 容器内的 MySQL）
#   - false: 使用 Docker 容器内的 MySQL（默认）
#   - true: 使用外部已有的 MySQL 服务
USE_EXTERNAL_DB=true

# USE_EXTERNAL_REDIS: 是否使用外部 Redis（非 Docker 容器内的 Redis）
#   - false: 使用 Docker 容器内的 Redis（默认）
#   - true: 使用外部已有的 Redis 服务
USE_EXTERNAL_REDIS=true

# -----------------------------------------------------------------------------
# MySQL 配置
# -----------------------------------------------------------------------------
# 外部数据库时使用的主机地址（当 USE_EXTERNAL_DB=true 时生效）
# 示例: 192.168.1.100 或 db.yourdomain.com
MYSQL_HOST=10.0.12.8

# 外部数据库端口（当 USE_EXTERNAL_DB=true 时生效）
MYSQL_EXTERNAL_PORT=3306

# Docker 内部 MySQL 端口（映射到宿主机的端口）
MYSQL_PORT=13306

# MySQL 用户名
MYSQL_USER=root

# MySQL 密码（生产环境必须修改！建议使用 16 位以上复杂密码）
MYSQL_ROOT_PASSWORD=123456

# MySQL 默认数据库
MYSQL_DATABASE=game_platform

# -----------------------------------------------------------------------------
# Redis 配置
# -----------------------------------------------------------------------------
# 外部 Redis 时使用的主机地址（当 USE_EXTERNAL_REDIS=true 时生效）
# 示例: 192.168.1.100 或 redis.yourdomain.com
REDIS_HOST=10.0.12.8

# 外部 Redis 端口（当 USE_EXTERNAL_REDIS=true 时生效）
REDIS_EXTERNAL_PORT=6379

# Docker 内部 Redis 端口（映射到宿主机的端口）
REDIS_PORT=16379

# Redis 密码（生产环境必须修改！建议使用 16 位以上复杂密码）
REDIS_PASSWORD=66b3901d744108a4

# Redis 默认数据库索引（0-15）
REDIS_DATABASE=0

# -----------------------------------------------------------------------------
# Kafka 配置（可选）
# -----------------------------------------------------------------------------
# 是否启用 Kafka
USE_KAFKA=false

# Kafka 端口
KAFKA_PORT=19092

# Kafka 外部主机地址（当 USE_KAFKA=true 且使用外部 Kafka 时）
KAFKA_HOST=kafka

# -----------------------------------------------------------------------------
# 服务端口配置
# -----------------------------------------------------------------------------
SERVICE_REGISTRY_PORT=8090
USER_SERVICE_PORT=8082
AUTH_SERVICE_PORT=8083
GAME_DATA_SERVICE_PORT=8084
GOMOKU_HTTP_PORT=8085
GOMOKU_WS_PORT=8086

# -----------------------------------------------------------------------------
# Nginx 端口配置
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# JWT 配置
# -----------------------------------------------------------------------------
# JWT 密钥（生产环境必须修改！建议使用 32 位以上包含大小写字母数字特殊字符）
JWT_SECRET_KEY=hxrCfTkJX0Cry2ItS7TXxenOnAMSFmiBUf2fMLUz0UM

# JWT 过期时间（秒）
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

# -----------------------------------------------------------------------------
# 日志级别
# -----------------------------------------------------------------------------
# 可选: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 服务间通信配置
# -----------------------------------------------------------------------------
# 服务注册中心地址（用于服务发现）
SERVICE_REGISTRY_HOST=service-registry
SERVICE_REGISTRY_INTERNAL_PORT=8090

# 用户服务地址
USER_SERVICE_HOST=user-service
USER_SERVICE_INTERNAL_PORT=8082

# 认证服务地址
AUTH_SERVICE_HOST=auth-service
AUTH_SERVICE_INTERNAL_PORT=8083

# 游戏数据服务地址
GAME_DATA_SERVICE_HOST=game-data-service
GAME_DATA_SERVICE_INTERNAL_PORT=8084

# 五子棋服务地址
GOMOKU_SERVICE_HOST=gomoku-server
GOMOKU_HTTP_INTERNAL_PORT=8085
GOMOKU_WS_INTERNAL_PORT=8086

# -----------------------------------------------------------------------------
# 性能配置
# -----------------------------------------------------------------------------
# MySQL 连接池大小
MYSQL_POOL_SIZE=20

# Redis 连接池大小
REDIS_POOL_SIZE=10

# 工作线程数（建议设置为 CPU 核心数）
WORKER_THREADS=4

# IO 线程数（建议设置为 CPU 核心数）
IO_THREADS=2

# -----------------------------------------------------------------------------
# 安全配置
# -----------------------------------------------------------------------------
# 是否启用 CORS
ENABLE_CORS=true

# CORS 允许的源（逗号分隔，* 表示允许所有）
CORS_ALLOWED_ORIGINS=*

# 是否启用速率限制
ENABLE_RATE_LIMIT=true

# 每分钟最大请求数
RATE_LIMIT_REQUESTS_PER_MINUTE=1000

# -----------------------------------------------------------------------------
# 运行环境配置
# -----------------------------------------------------------------------------
# 运行环境标识 (development, testing, staging, production)
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 服务模式配置
# -----------------------------------------------------------------------------
# 服务模式 (simple, standard, enterprise)
SERVICE_MODE=simple

# -----------------------------------------------------------------------------
# 会话加密配置
# -----------------------------------------------------------------------------
# 会话加密密钥（生产环境必须修改！）
SESSION_ENCRYPTION_KEY=your_session_encryption_key_here

# -----------------------------------------------------------------------------
# SMTP 邮件配置
# -----------------------------------------------------------------------------
# SMTP 服务器地址
SMTP_HOST=smtp.gmail.com
# SMTP 端口
SMTP_PORT=587
# SMTP 用户名
SMTP_USER=
# SMTP 密码
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# 第三方登录配置
# -----------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 微信登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Steam 登录
STEAM_APP_ID=
STEAM_API_KEY=

# QQ 登录
QQ_APP_ID=
QQ_APP_KEY=
